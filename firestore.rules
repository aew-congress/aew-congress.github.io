rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profileIsSuperadmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'superadmin';
    }

    function profileIsAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperadmin() {
      return verified()
        && (request.auth.token.email == 'rjamescute2@gmail.com' || profileIsSuperadmin());
    }

    function isAdmin() {
      return verified()
        && (request.auth.token.email == 'rjamescute2@gmail.com' || profileIsAdmin());
    }

    function isApprovedMember() {
      return verified()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.status == 'Approved'
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.emailVerified == true;
    }

    function isRegularMember() {
      return isApprovedMember()
        && !isAdmin()
        && (!('role' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'regular');
    }

    function isEvaluationGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isGuestEvaluationSession(respondentUid) {
      return request.auth == null
        && respondentUid.matches('guest-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
    }

    function validRpRatings(data) {
      return data.ratings is list
        && data.ratings.size() == 5
        && data.ratings[0] in [5, 4, 3, 2, 1, 'NA']
        && data.ratings[1] in [5, 4, 3, 2, 1, 'NA']
        && data.ratings[2] in [5, 4, 3, 2, 1, 'NA']
        && data.ratings[3] in [5, 4, 3, 2, 1, 'NA']
        && data.ratings[4] in [5, 4, 3, 2, 1, 'NA'];
    }

    function validRpProgram(data, programId) {
      return exists(/databases/$(database)/documents/programs/$(programId))
        && data.programTitle == get(/databases/$(database)/documents/programs/$(programId)).data.eventTitle
        && data.dateFrom == get(/databases/$(database)/documents/programs/$(programId)).data.dateFrom
        && data.dateTo == get(/databases/$(database)/documents/programs/$(programId)).data.dateTo
        && data.venue == get(/databases/$(database)/documents/programs/$(programId)).data.venue;
    }

    function validRpSpeaker(data, speakerId) {
      return exists(/databases/$(database)/documents/speakers/$(speakerId))
        && data.speakerName == get(/databases/$(database)/documents/speakers/$(speakerId)).data.name;
    }

    function validRpMember(data, respondentUid) {
      return signedIn()
        && request.auth.uid == respondentUid
        && (isRegularMember() || isAdmin())
        && exists(/databases/$(database)/documents/userProfiles/$(respondentUid))
        && data.respondentKind == 'member'
        && data.respondentFirstName == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.firstName
        && data.respondentMiddleName == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.middleName
        && data.respondentLastName == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.lastName
        && data.respondentSuffix == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.suffix
        && data.respondentName == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.firstName
          + (get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.middleName == '' ? '' : ' ' + get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.middleName)
          + ' ' + get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.lastName
          + (get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.suffix == '' ? '' : ' ' + get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.suffix)
        && data.respondentSexAtBirth == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.sexAtBirth
        && data.respondentAgency == get(/databases/$(database)/documents/userProfiles/$(respondentUid)).data.office;
    }

    function validRpGuest(data, respondentUid) {
      return data.respondentKind == 'guest'
        && data.respondentName is string
        && data.respondentName.size() > 0
        && data.respondentName.size() <= 180
        && data.respondentSexAtBirth in ['Male', 'Female']
        && data.respondentAgency is string
        && data.respondentAgency.size() > 0
        && data.respondentAgency.size() <= 240
        && data.respondentFirstName == ''
        && data.respondentMiddleName == ''
        && data.respondentLastName == ''
        && data.respondentSuffix == ''
        && ((signedIn() && isEvaluationGuest() && request.auth.uid == respondentUid)
          || isGuestEvaluationSession(respondentUid));
    }

    function validRpSubmission(data, programId, speakerId, respondentUid) {
      return data.keys().hasAll([
          'programId', 'programTitle', 'dateFrom', 'dateTo', 'venue',
          'speakerId', 'speakerName', 'sessionTitle', 'respondentUid',
          'respondentKind', 'respondentName', 'respondentFirstName',
          'respondentMiddleName', 'respondentLastName', 'respondentSuffix',
          'respondentSexAtBirth', 'respondentAgency', 'ratings',
          'otherComments', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'programId', 'programTitle', 'dateFrom', 'dateTo', 'venue',
          'speakerId', 'speakerName', 'sessionTitle', 'respondentUid',
          'respondentKind', 'respondentName', 'respondentFirstName',
          'respondentMiddleName', 'respondentLastName', 'respondentSuffix',
          'respondentSexAtBirth', 'respondentAgency', 'ratings',
          'otherComments', 'submittedAt'
        ])
        && data.programId == programId
        && data.speakerId == speakerId
        && data.respondentUid == respondentUid
        && validRpProgram(data, programId)
        && validRpSpeaker(data, speakerId)
        && data.sessionTitle is string
        && data.sessionTitle.size() <= 2000
        && data.otherComments is string
        && data.otherComments.size() <= 2000
        && data.submittedAt == request.time
        && validRpRatings(data);
    }

    function isDesignatedJudge() {
      return verified()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.judge == 'Yes'
        && (isAdmin() || isRegularMember());
    }

    function canConfirmEmailVerification(uid) {
      return signedIn()
        && request.auth.uid == uid
        && verified()
        && request.auth.token.email == resource.data.email
        && (!('emailVerified' in resource.data) || resource.data.emailVerified == false)
        && request.resource.data.emailVerified == true
        && (
          (resource.data.status == 'Unverified' && request.resource.data.status == 'Pending')
          || (resource.data.status in ['Pending', 'Approved', 'Disapproved']
            && request.resource.data.status == resource.data.status)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'status']);
    }

    match /userProfiles/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isSuperadmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'regular'
        && request.resource.data.emailVerified == false
        && request.resource.data.status == 'Unverified'
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'middleName', 'lastName', 'suffix', 'birthdate',
          'sexAtBirth', 'contactNo', 'position', 'designation', 'office',
          'email', 'role', 'emailVerified', 'status', 'createdAt'
        ]);
      allow update: if canConfirmEmailVerification(uid)
        || (isSuperadmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedAt', 'status', 'reviewedAt', 'judge'])
          && (!('role' in request.resource.data) || request.resource.data.role in ['superadmin', 'admin', 'regular'])
          && (!('judge' in request.resource.data) || request.resource.data.judge in ['Yes', 'No'])
          && request.resource.data.status in ['Pending', 'Approved', 'Disapproved']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || resource.data.emailVerified == true));
      allow delete: if isSuperadmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if isAdmin() || isApprovedMember() || resource.data.enabled == true;
      allow create, update, delete: if isAdmin();
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contestMechanics/{contestId} {
      allow read: if true;
      allow create: if isSuperadmin()
        || (isAdmin()
          && (!('rankingsRevealed' in request.resource.data)
            || request.resource.data.rankingsRevealed == false));
      allow delete: if isAdmin();
      allow update: if isSuperadmin()
        || (isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rankingsRevealed']));
    }

    match /contestJoins/{joinId} {
      allow read: if isAdmin()
        || (isApprovedMember() && resource.data.uid == request.auth.uid);
      allow create: if isRegularMember()
        && request.resource.data.keys().hasAll([
          'contestId', 'programId', 'contest', 'uid', 'joinedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'contestId', 'programId', 'contest', 'uid', 'joinedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && joinId == request.resource.data.contestId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/contestMechanics/$(request.resource.data.contestId))
        && get(/databases/$(database)/documents/contestMechanics/$(request.resource.data.contestId)).data.programId == request.resource.data.programId
        && get(/databases/$(database)/documents/contestMechanics/$(request.resource.data.contestId)).data.contest == request.resource.data.contest;
      allow update, delete: if isAdmin();
    }

    match /contestScoreSheets/{contestId}/judges/{judgeUid} {
      allow get: if isSuperadmin()
        || (isAdmin()
          && get(/databases/$(database)/documents/contestMechanics/$(contestId)).data.rankingsRevealed == true)
        || (isDesignatedJudge() && judgeUid == request.auth.uid);
      allow list: if isSuperadmin()
        || (isAdmin()
          && get(/databases/$(database)/documents/contestMechanics/$(contestId)).data.rankingsRevealed == true);
      allow create, update: if isDesignatedJudge()
        && judgeUid == request.auth.uid
        && exists(/databases/$(database)/documents/contestMechanics/$(contestId))
        && request.resource.data.keys().hasAll(['contestId', 'judgeUid', 'teams', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['contestId', 'judgeUid', 'teams', 'updatedAt'])
        && request.resource.data.contestId == contestId
        && request.resource.data.judgeUid == request.auth.uid
        && request.resource.data.teams is list
        && request.resource.data.teams.size() <= 50;
      allow delete: if false;
    }

    match /attendanceConfirmations/{confirmationId} {
      allow get: if isAdmin()
        || (isRegularMember()
          && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isRegularMember()
        && request.resource.data.keys().hasAll(['programId', 'uid', 'confirmedAt'])
        && request.resource.data.keys().hasOnly(['programId', 'uid', 'confirmedAt'])
        && request.resource.data.programId is string
        && request.resource.data.uid == request.auth.uid
        && confirmationId == request.resource.data.programId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/programs/$(request.resource.data.programId))
        && request.resource.data.confirmedAt == request.time;
      allow update, delete: if false;
    }

    match /programEvaluations/{programId}/responses/{respondentUid} {
      allow get: if isAdmin()
        || (signedIn() && respondentUid == request.auth.uid && (isRegularMember() || isEvaluationGuest()))
        || isGuestEvaluationSession(respondentUid);
      allow list: if isAdmin();
      allow create: if request.resource.data.respondentUid == respondentUid
        && request.resource.data.programId == programId
        && ((signedIn()
            && respondentUid == request.auth.uid
            && ((isRegularMember() && request.resource.data.respondentKind == 'member')
              || (isEvaluationGuest() && request.resource.data.respondentKind == 'guest')))
          || (isGuestEvaluationSession(respondentUid) && request.resource.data.respondentKind == 'guest'))
        && request.resource.data.keys().hasAll([
          'programId', 'programTitle', 'respondentUid', 'respondentKind', 'name',
          'clientType', 'beneficiaryType', 'beneficiaryCategory', 'beneficiaryOther',
          'registrationId', 'contactNo', 'groupName', 'firstName', 'middleName',
          'lastName', 'suffix', 'region', 'province', 'cityMunicipality', 'barangay',
          'street', 'sex', 'birthdate', 'membership', 'interventions',
          'interventionOtherQuantity', 'interventionOtherDetail', 'cc1', 'cc2', 'cc3',
          'overallSatisfaction', 'qualityScores', 'deliveryScore', 'suggestions',
          'caDistributed', 'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'programId', 'programTitle', 'respondentUid', 'respondentKind', 'name',
          'clientType', 'beneficiaryType', 'beneficiaryCategory', 'beneficiaryOther',
          'registrationId', 'contactNo', 'groupName', 'firstName', 'middleName',
          'lastName', 'suffix', 'region', 'province', 'cityMunicipality', 'barangay',
          'street', 'sex', 'birthdate', 'membership', 'interventions',
          'interventionOtherQuantity', 'interventionOtherDetail', 'cc1', 'cc2', 'cc3',
          'overallSatisfaction', 'qualityScores', 'deliveryScore', 'suggestions',
          'caDistributed', 'submittedAt'
        ])
        && request.resource.data.caDistributed == false
        && request.resource.data.submittedAt == request.time
        && get(/databases/$(database)/documents/programs/$(programId)).data.evaluationRevealed == true;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caDistributed'])
        && request.resource.data.caDistributed is bool;
      allow delete: if false;
    }

    match /resourcePersonEvaluations/{programId}/speakers/{speakerId}/rpSubmissions/{respondentUid} {
      allow get: if isAdmin()
        || (signedIn() && respondentUid == request.auth.uid
          && (isRegularMember() || isAdmin() || isEvaluationGuest()))
        || isGuestEvaluationSession(respondentUid);
      allow list: if isAdmin();
      allow create: if validRpSubmission(request.resource.data, programId, speakerId, respondentUid)
        && (validRpMember(request.resource.data, respondentUid)
          || validRpGuest(request.resource.data, respondentUid));
      allow update, delete: if false;
    }

    // Required for admin collectionGroup queries across all program/speaker submissions.
    match /{path=**}/rpSubmissions/{respondentUid} {
      allow list: if isAdmin()
        || (signedIn()
          && resource.data.respondentUid == request.auth.uid
          && (isRegularMember() || isEvaluationGuest()))
        || (request.auth == null
          && isGuestEvaluationSession(resource.data.respondentUid));
    }

    // Email documents are server-created and consumed by the Firebase Trigger Email extension.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
